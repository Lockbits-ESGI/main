# ── EDR Server ───────────────────────────────────────────────────────────
# REQUIRED: Authentication token for the EDR API (no default - must be set)
EDR_AUTH_TOKEN=
EDR_PORT=8001

# Database: PostgreSQL connection for production.
# Format: postgresql+asyncpg://user:password@host/dbname
# For local dev with SQLite, override: sqlite:///./miniedr.db
EDR_DATABASE_URL=postgresql+asyncpg://edr:changeme@edr-db/edr
EDR_DB_USER=edr
EDR_DB_PASS=changeme
EDR_DB_NAME=edr

VT_ENABLED=false
VT_API_KEY=
# comma-separated allowed origins, or "*" to allow all (dev default)
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── LockBits Site ─────────────────────────────────────────────────────────
WEB_PORT=8080
APP_NAME=LockBits Client Area
APP_ENV=production

# Database MySQL — géré par un service Dokploy séparé (externe au compose)
# DB_HOST : hostname/IP du MySQL Dokploy (host.docker.internal si même hôte)
# DB_PORT : port exposé par le service Dokploy MySQL
#   - prod    → 3377  (configurer le service Dokploy MySQL sur ce port)
#   - preprod → 3366  (configurer le service Dokploy MySQL sur ce port)
#
# Config à appliquer dans le service Dokploy MySQL :
#   MYSQL_DATABASE=lockbits_client
#   MYSQL_USER=lockbits
#   MYSQL_PASSWORD=<DB_PASS>
#   MYSQL_ROOT_PASSWORD=<mot de passe root>
DB_HOST=host.docker.internal
DB_PORT=3377
DB_NAME=lockbits_client
DB_USER=lockbits
DB_PASS=changeme

# GLPI integration
GLPI_API_URL=
GLPI_WEB_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_API_USERNAME=
GLPI_API_PASSWORD=

# Monitoring — prod (defaults: Grafana=3002, Prometheus=9092)
# GRAFANA_PORT=3002
# PROMETHEUS_PORT=9092

# Monitoring — preprod (defaults: Grafana=3001, Prometheus=9090)
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090

# PHP
PHP_MEMORY_LIMIT=256M
