# ── EDR Server ───────────────────────────────────────────────────────────
# REQUIRED: Authentication token for the EDR API (no default - must be set)
EDR_AUTH_TOKEN=
EDR_PORT=8001

# Database: PostgreSQL connection for production.
# Format: postgresql+asyncpg://user:password@host/dbname
# For local dev with SQLite, override: sqlite:///./miniedr.db
EDR_DATABASE_URL=postgresql+asyncpg://edr:changeme@edr-db/edr
EDR_DB_USER=edr
EDR_DB_PASS=changeme
EDR_DB_NAME=edr

VT_ENABLED=false
VT_API_KEY=
# comma-separated allowed origins, or "*" to allow all (dev default)
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── LockBits Site ─────────────────────────────────────────────────────────
WEB_PORT=8080
APP_NAME=LockBits Client Area
APP_ENV=production

# Database — REQUIRED: all passwords must be set, no defaults
DB_NAME=lockbits_client
DB_USER=lockbits
DB_PASS=changeme
DB_ROOT_PASSWORD=changeme
DB_EXPOSE_PORT=3307

# GLPI integration
GLPI_API_URL=
GLPI_WEB_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_API_USERNAME=
GLPI_API_PASSWORD=

# Monitoring (optional — defaults: Grafana=3000, Prometheus=9090)
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# PHP
PHP_MEMORY_LIMIT=256M
