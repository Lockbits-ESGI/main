{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "EDR - LockBits",
  "uid": "lockbits-edr-v2",
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["edr", "lockbits"],
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Overview", "id": 1, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 2, "type": "stat", "title": "DB Health",
      "gridPos": { "x": 0, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "1": { "text": "Healthy", "color": "green" }, "0": { "text": "Down", "color": "red" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "edr_db_health", "legendFormat": "DB" }]
    },
    {
      "id": 3, "type": "stat", "title": "Active Agents",
      "gridPos": { "x": 3, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{ "expr": "edr_active_agents", "legendFormat": "Active" }]
    },
    {
      "id": 4, "type": "stat", "title": "Agents Enregistrés",
      "gridPos": { "x": 6, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } } },
      "targets": [{ "expr": "edr_agents_total", "legendFormat": "Total" }]
    },
    {
      "id": 5, "type": "stat", "title": "Total Events (DB)",
      "gridPos": { "x": 9, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } } },
      "targets": [{ "expr": "edr_events_db_total", "legendFormat": "Total" }]
    },
    {
      "id": 6, "type": "stat", "title": "Events (24h)",
      "gridPos": { "x": 12, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "expr": "edr_events_24h_total", "legendFormat": "24h" }]
    },
    {
      "id": 7, "type": "stat", "title": "Events (1h)",
      "gridPos": { "x": 15, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 500 }] } } },
      "targets": [{ "expr": "edr_events_1h_total", "legendFormat": "1h" }]
    },
    {
      "id": 8, "type": "stat", "title": "Auth Failures",
      "gridPos": { "x": 18, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "increase(edr_auth_failures_total[5m])", "legendFormat": "5m" }]
    },
    {
      "id": 9, "type": "stat", "title": "Ingestion Rate",
      "gridPos": { "x": 21, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } } },
      "targets": [{ "expr": "sum(rate(edr_events_ingested_total[2m]))", "legendFormat": "events/s" }]
    },
    { "type": "row", "title": "Agents", "id": 10, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 11, "type": "piechart", "title": "Online / Offline",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "targets": [
        { "expr": "edr_agents_online_total", "legendFormat": "Online" },
        { "expr": "edr_agents_offline_total", "legendFormat": "Offline" }
      ]
    },
    {
      "id": 12, "type": "piechart", "title": "Agents par Plateforme",
      "gridPos": { "x": 6, "y": 6, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "pieType": "pie", "displayLabels": ["name", "percent"] },
      "targets": [{ "expr": "edr_agents_by_platform_total", "legendFormat": "{{platform}}" }]
    },
    {
      "id": 13, "type": "table", "title": "Agents par Version",
      "gridPos": { "x": 12, "y": 6, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [{ "expr": "edr_agents_by_version_total", "legendFormat": "{{version}}", "instant": true, "format": "table" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "Active Agents",
      "gridPos": { "x": 18, "y": 6, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "edr_active_agents", "legendFormat": "Actifs" }]
    },
    { "type": "row", "title": "Events", "id": 15, "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 16, "type": "timeseries", "title": "Ingestion Rate par type",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by(event_type) (rate(edr_events_ingested_total[2m]))", "legendFormat": "{{event_type}}" }]
    },
    {
      "id": 17, "type": "piechart", "title": "Events par Type (DB)",
      "gridPos": { "x": 12, "y": 15, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "pieType": "pie", "displayLabels": ["name", "percent"] },
      "targets": [{ "expr": "edr_events_by_type_total", "legendFormat": "{{event_type}}" }]
    },
    {
      "id": 18, "type": "piechart", "title": "Events par Sévérité (DB)",
      "gridPos": { "x": 18, "y": 15, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "targets": [{ "expr": "edr_events_by_severity_total", "legendFormat": "{{severity}}" }]
    },
    {
      "id": 19, "type": "timeseries", "title": "Events par Plateforme",
      "gridPos": { "x": 0, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "edr_events_by_platform_total", "legendFormat": "{{platform}}" }]
    },
    {
      "id": 20, "type": "stat", "title": "Batch Size (percentiles)",
      "gridPos": { "x": 8, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(edr_events_ingested_batch_size_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(edr_events_ingested_batch_size_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(edr_events_ingested_batch_size_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Events Rejetés",
      "gridPos": { "x": 16, "y": 23, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "lineWidth": 2, "fillOpacity": 20 } } },
      "targets": [
        { "expr": "rate(edr_events_rejected_total[2m])", "legendFormat": "Single rejetés" },
        { "expr": "rate(edr_batch_events_rejected_total[2m])", "legendFormat": "Batch rejetés" }
      ]
    },
    { "type": "row", "title": "FIM & Scan", "id": 22, "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 23, "type": "timeseries", "title": "FIM Events par Action",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by(action) (rate(edr_fim_events_total[2m]))", "legendFormat": "{{action}}" }]
    },
    {
      "id": 24, "type": "stat", "title": "FIM Suspicious (rate 5m)",
      "gridPos": { "x": 12, "y": 32, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.1 }] } } },
      "targets": [{ "expr": "rate(edr_fim_suspicious_total[5m])", "legendFormat": "FIM suspect/s" }]
    },
    {
      "id": 25, "type": "timeseries", "title": "Scan Events par Sévérité",
      "gridPos": { "x": 18, "y": 32, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by(severity) (rate(edr_scan_events_total[2m]))", "legendFormat": "{{severity}}" }]
    },
    { "type": "row", "title": "VirusTotal", "id": 26, "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 27, "type": "timeseries", "title": "VT Enrichissements",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "sum by(status) (rate(edr_vt_enrichments_total[2m]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 28, "type": "stat", "title": "Events Malicieux (DB)",
      "gridPos": { "x": 12, "y": 41, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "expr": "edr_vt_malicious_events_db_total", "legendFormat": "Malicieux" }]
    },
    {
      "id": 29, "type": "stat", "title": "Events Suspects (DB)",
      "gridPos": { "x": 16, "y": 41, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } } },
      "targets": [{ "expr": "edr_vt_suspicious_events_db_total", "legendFormat": "Suspects" }]
    },
    {
      "id": 30, "type": "stat", "title": "Hash Cache",
      "gridPos": { "x": 20, "y": 41, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } } },
      "targets": [{ "expr": "edr_hash_cache_entries_total", "legendFormat": "Entrées" }]
    },
    {
      "id": 31, "type": "piechart", "title": "Events par Statut VT",
      "gridPos": { "x": 12, "y": 45, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "targets": [{ "expr": "edr_events_by_vt_status_total", "legendFormat": "{{vt_status}}" }]
    },
    {
      "id": 32, "type": "piechart", "title": "Hash Cache par Verdict",
      "gridPos": { "x": 18, "y": 45, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "pieType": "pie", "displayLabels": ["name", "percent"] },
      "targets": [{ "expr": "edr_hash_cache_by_verdict_total", "legendFormat": "{{verdict}}" }]
    },
    { "type": "row", "title": "HTTP", "id": 33, "gridPos": { "x": 0, "y": 53, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 34, "type": "timeseries", "title": "HTTP Requests Rate par Endpoint",
      "gridPos": { "x": 0, "y": 54, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [{ "expr": "sum by(handler, method, status) (rate(http_requests_total[2m]))", "legendFormat": "{{handler}} {{method}} {{status}}" }]
    },
    {
      "id": 35, "type": "timeseries", "title": "HTTP Latency P95",
      "gridPos": { "x": 12, "y": 54, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by(handler, le) (rate(http_request_duration_seconds_bucket[2m])))", "legendFormat": "P95 {{handler}}" }]
    },
    {
      "id": 36, "type": "timeseries", "title": "HTTP Error Rate (4xx/5xx)",
      "gridPos": { "x": 0, "y": 62, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "lineWidth": 2, "fillOpacity": 20 } } },
      "targets": [{ "expr": "sum by(handler) (rate(http_requests_total{status=~\"4..|5..\"}[2m]))", "legendFormat": "{{handler}}" }]
    },
    {
      "id": 37, "type": "table", "title": "HTTP Requests Total (1h)",
      "gridPos": { "x": 12, "y": 62, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "sortBy": [{ "displayName": "Requests", "desc": true }] },
      "targets": [{ "expr": "sort_desc(sum by(handler, method, status) (increase(http_requests_total[1h])))", "legendFormat": "{{method}} {{handler}} {{status}}", "instant": true, "format": "table" }]
    },
    { "type": "row", "title": "Logs (Loki)", "id": 38, "gridPos": { "x": 0, "y": 70, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 39, "type": "logs", "title": "Logs EDR Server",
      "gridPos": { "x": 0, "y": 71, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "wrapLogMessage": true },
      "targets": [{ "expr": "{container_name=\"lockbits_edr_preprod\"}", "refId": "A" }]
    }
  ]
}
